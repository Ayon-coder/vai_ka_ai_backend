# ==========================================
# IEEE Chatbot Backend Environment Variables
# ==========================================

# Select your preferred LLM backend ('gemini' or 'groq')
# Default is gemini if left empty.
LLM_PROVIDER=gemini

# ------------------------------------------
# Gemini Configuration (Used for Gemini Backend & Vector Embeddings)
# ------------------------------------------
# Get your key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------
# Groq Configuration (Used ONLY if LLM_PROVIDER=groq)
# ------------------------------------------
# Get your key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------
# Firebase Configuration
# ------------------------------------------
# Base64 encoded Firebase Service Account JSON credentials
# Used to authenticate with Firestore for Student Branch mode.
FIREBASE_CREDS_BASE64=your_base64_encoded_firebase_creds_here
