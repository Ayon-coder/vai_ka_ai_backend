# API keys (comma-separated for round-robin rotation & rate-limit failover)
GROQ_API_KEY=key1,key2
CATEGORICAL_MODEL_API_KEY=key1,key2
WATCHER_MODEL_API_KEY=key1,key2

# Models
GROQ_MODEL_NAME=groq/compound
CATEGORICAL_MODEL=openai/gpt-oss-20b
WATCHER_MODEL=openai/gpt-oss-20b
FRONTEND_URL=http://localhost:5173

# Firebase Admin service-account JSON, base64-encoded.
FIREBASE_CREDS_BASE64=
# Google API key(s) for embeddings (comma-separated for round-robin)
GOOGLE_API_KEY=google_key1,google_key2
FIREBASE_COLLECTION=ieee-members
STUDENT_BRANCH_TOP_K=4
STUDENT_BRANCH_MIN_SIMILARITY=0.35
